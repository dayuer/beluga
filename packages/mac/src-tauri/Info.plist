<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Merged into the app's Info.plist by Tauri. macOS shows these words when it asks. -->
  <!-- The languages the window speaks (Settings › Appearance › Language): with Chinese listed, the
       items macOS adds itself (Start Dictation, Emoji & Symbols, the Window menu's tiling) and its
       panels (Open, Save) follow a Chinese Mac too. Permission prompts: zh-Hans.lproj/InfoPlist.strings. -->
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>zh-Hans</string>
  </array>
  <key>NSAppleEventsUsageDescription</key>
  <string>Claude can work with your other apps for you, such as Finder or Safari, when you ask it to.</string>
  <!-- Settings › Voice: speaking instead of typing, written down on this Mac. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Beluga writes down what you say, on this Mac, so you can speak to Claude instead of typing, and carries your voice in calls with friends. Recordings are written down here and never leave your Mac.</string>
  <key>NSCameraUsageDescription</key>
  <string>Beluga shows your camera to the friends you're in a call with, straight from this Mac to theirs.</string>
</dict>
</plist>
