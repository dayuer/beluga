{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*"],
      "zod": ["./node_modules/zod"],
      "zod/*": ["./node_modules/zod/*"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-native": ["./node_modules/react-native/types_generated/index.d.ts"],
      "lucide-react-native": ["./node_modules/lucide-react-native/dist/types/lucide-react-native.d.ts"]
    }
  },
  "include": ["app", "lib", "components", "../ui-plan", "../../src/studio/protocol.ts"],
  "exclude": ["node_modules", "dist", "web-build", ".expo"]
}
