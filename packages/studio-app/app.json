{
  "expo": {
    "name": "Synon Studio",
    "slug": "synon-studio",
    "version": "0.1.0",
    "scheme": "synon",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F6F7",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.synon.studio",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "appleTeamId": "L9YRXEKYN2"
    },
    "android": {
      "package": "com.synon.studio"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "lang": "zh-CN",
      "themeColor": "#FFFFFF"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
