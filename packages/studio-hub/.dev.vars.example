# Copy to .dev.vars for `wrangler dev` (never commit that file).
OPERATOR_TOKEN=dev-operator-token
# outbox (default): keep links in D1 for the admin page. resend: real email (BLG-82).
# console: only logs "link issued" (no token).
MAIL_MODE=outbox
# Only for MAIL_MODE=resend; without the key the hub falls back to the outbox.
RESEND_API_KEY=
MAIL_FROM=Synon Studio <login@synon.studio>
# Required for magic links; a missing/non-absolute origin makes the hub refuse to issue a link.
HUB_ORIGIN=http://localhost:8787
# P1 never signs preview links; P2 sets this.
PREVIEW_SECRET=
